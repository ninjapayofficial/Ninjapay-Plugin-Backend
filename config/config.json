
{
  "development": {
    "url": "${DEV_DATABASE_URL}",
    "dialect": "postgres",
    "dialectOptions": {
      "ssl": {
        "require": true,
        "rejectUnauthorized": false
      }
    }
  },
  "test": {
    "username": "${TEST_DB_USER}",
    "password": "${TEST_DB_PASSWORD}",
    "database": "${TEST_DB_NAME}",
    "host": "${TEST_DB_HOST}",
    "dialect": "postgres"
  },
  "production": {
    "url": "${PROD_DATABASE_URL}",
    "dialect": "postgres",
    "dialectOptions": {
      "ssl": {
        "require": true,
        "rejectUnauthorized": false
      }
    }
  }
}
